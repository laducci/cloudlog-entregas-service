PORT=8080
# memory | mongo
DELIVERY_REPOSITORY=mongo
MONGODB_URI=mongodb+srv://<usuario>:<senha>@<cluster>.mongodb.net/
MONGODB_DB=cloudlog
MONGODB_COLLECTION=entregas
# memory | servicebus | log
EVENT_PUBLISHER=servicebus
SERVICEBUS_CONNECTION=Endpoint=sb://<namespace>.servicebus.windows.net/;SharedAccessKeyName=...;SharedAccessKey=...
SERVICEBUS_QUEUE=cloudlog-entregas-eventos
